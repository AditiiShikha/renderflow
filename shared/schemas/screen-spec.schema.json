{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "renderflow://schemas/screen-spec.schema.json",
  "title": "ScreenSpec",
  "description": "Response body of POST /api/generate-screen.",
  "type": "object",
  "required": ["title", "layout", "trigger", "widgets"],
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string" },
    "layout": { "type": "string", "enum": ["grid"] },
    "trigger": { "$ref": "trigger.schema.json" },
    "widgets": {
      "type": "array",
      "items": { "$ref": "widget.schema.json" }
    }
  }
}
