{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "renderflow://schemas/tag.schema.json",
  "title": "Tag",
  "type": "object",
  "required": ["id", "name", "unit", "min", "max", "warnThreshold", "critThreshold", "assetId", "category"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "unit": { "type": "string" },
    "min": { "type": "number" },
    "max": { "type": "number" },
    "warnThreshold": { "type": "number" },
    "critThreshold": { "type": "number" },
    "assetId": { "type": "string" },
    "category": { "type": "string" }
  }
}
