{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "renderflow://schemas/line.schema.json",
  "title": "Line",
  "description": "Two-level asset hierarchy: line -> asset. Assets do not nest further.",
  "type": "object",
  "required": ["id", "name", "assets"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "tagIds"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "tagIds": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
